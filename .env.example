FRED_API_KEY=your_fred_api_key_here
OLLAMA_BASE_URL=https://your-ollama-host.example.com
OLLAMA_MODEL=gemma4:31b-cloud
# OLLAMA_API_KEY=your-ollama-api-key  # optional, uncomment if your Ollama instance requires auth

# Shared production request limits (Redis REST API, e.g. Upstash).
# RATE_LIMIT_REDIS_REST_URL=https://your-database.upstash.io
# RATE_LIMIT_REDIS_REST_TOKEN=your-write-token
# REQUIRE_SHARED_RATE_LIMIT=true
# Without Redis, limits are best-effort per process, NOT deployment-wide.
# FRED_CLIENT_PER_MINUTE=90
# FRED_GLOBAL_PER_MINUTE=100
# FRED_GLOBAL_PER_DAY=20000
# AI_CLIENT_PER_MINUTE=6
# AI_GLOBAL_PER_MINUTE=20
# AI_GLOBAL_PER_DAY=500
